{
  "name": "prototype-bootstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:portability": "node scripts/check-portability.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "vinext build",
    "build:interactive": "vite build --config vite.interactive.config.ts && node scripts/prepare-interactive-build.mjs && node scripts/optimize-interactive-assets.mjs",
    "start": "vinext start",
    "test": "vitest run --config vitest.config.mjs",
    "test:soak": "vitest run --config vitest.soak.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "next": "16.2.6",
    "partial-json": "^0.1.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  }
}
